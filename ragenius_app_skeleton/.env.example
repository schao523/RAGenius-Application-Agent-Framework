POSTGRES_USER=ragenius
POSTGRES_PASSWORD=ragenius
POSTGRES_DB=ragenius
DATABASE_URL=postgresql://ragenius:ragenius@localhost:5433/ragenius
RAGENIUS_EXECUTION_SUBSYSTEM_URL=http://127.0.0.1:3001/v1
# Must match the ragenius_app credential in RAGENIUS_EXECUTION_SERVICE_CREDENTIALS_JSON.
RAGENIUS_EXECUTION_SERVICE_TOKEN=replace-app-token
RAGENIUS_AGENT_INPUT_MAX_BYTES=536870912
RAGENIUS_LLM_CONTEXT_OPTIMIZATION=0
RAGENIUS_LLM_CONTEXT_OPTIMIZATION_MODE=off
RAGENIUS_LLM_EVIDENCE_ANALYSIS_MODE=auto
