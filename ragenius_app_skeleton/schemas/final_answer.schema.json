
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/final_answer.schema.json",
  "title": "Final Answer Schema v1.1c",
  "type": "object",
  "required": ["content", "citations", "missing_infoTypes"],
  "properties": {
    "content": { "type": "string" },

    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["docId", "title", "snippet", "score"],
        "properties": {
          "docId": { "type": "string" },
          "title": { "type": "string" },
          "snippet": { "type": "string" },
          "score": { "type": "number" },
          "location": { "type": ["string", "null"] },
          "version": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },

    "missing_infoTypes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
