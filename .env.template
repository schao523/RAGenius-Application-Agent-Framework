# RAGenius public demo configuration.
# Copy this file to .env, then set the LLM key before running scripts\Start-Demo.ps1.

# PostgreSQL/pgvector infrastructure started by compose.yml.
POSTGRES_USER=ragenius
POSTGRES_PASSWORD=ragenius
POSTGRES_DB=ragenius
DATABASE_URL=postgresql://ragenius:ragenius@localhost:5433/ragenius_execution?schema=public
RAG_VECTOR_STORE_BACKEND=pgvector
RAG_VECTOR_STORE_DSN=postgresql://ragenius:ragenius@localhost:5433/ragenius
RAG_PGVECTOR_BOOTSTRAP=true

# Retrieval/ingestion embedding runtime.
# Run scripts\Setup-Embeddings.ps1 before ingesting demo documents.
RAG_EMBEDDING_BACKEND=local
# Source-checkout defaults resolve to rag_subsystem\models\bge-large-zh and rag_subsystem\models\e5-large.
# RAG_EMBEDDING_MODEL_PATH_BGE_LARGE_ZH=
# RAG_EMBEDDING_MODEL_PATH_E5_LARGE=

# LLM responses require an internet connection and at least one real API key.
# DeepSeek is the current default used by the official demo app settings.
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# RAGENIUS_LLM_API_KEY=
# RAGENIUS_LLM_BASE_URL=

# Execution subsystem service wiring.
RAGENIUS_EXECUTION_BASE_URL=http://127.0.0.1:3001
RAGENIUS_EXECUTION_SUBSYSTEM_URL=http://127.0.0.1:3001/v1
RAGENIUS_EXECUTION_SERVICE_AUTH_REQUIRED=false
RAGENIUS_EXECUTION_SERVICE_ID=ragenius_app
# RAGENIUS_EXECUTION_SERVICE_TOKEN=
# RAGENIUS_EXECUTION_SERVICE_CREDENTIALS_JSON=[]

# Builder/admin wiring.
RAGENIUS_BUILDER_INSTANCE_ID=builder-primary
RAGENIUS_BUILDER_EXECUTION_TIMEOUT_SECONDS=120
# RAGENIUS_BUILDER_ADMIN_TOKEN=
# RAGENIUS_BUILDER_EXECUTION_SERVICE_TOKEN=

# Safe public-demo defaults for interactive external tooling.
AGENT_ASYNC_EXECUTION_ENABLED=true
CODEX_CLI_ENABLED=false
CODEX_APP_SERVER_INTERACTIVE_ENABLED=false
CODEX_MCP_ELICITATION_ENABLED=false
CODEX_INTERACTIVE_AUTH_HANDOFF_ENABLED=false
CODEX_INTERACTIVE_USER_ACTION_ENABLED=false
CODEX_MCP_AUTH_ALLOWED_HOSTS_JSON=[]
CODEX_MANAGED_AUTH_TARGETS_JSON=[]
OPENCLAW_GATEWAY_INTERACTIVE_ENABLED=false
OPENCLAW_GATEWAY_CHAT_LEVEL_ENABLED=false
