generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Execution {
  id          String   @id
  requestType String   @map("request_type")
  appId       String   @map("app_id")
  sessionId   String   @map("session_id")
  skillId     String   @map("skill_id")
  requestPayload Json  @map("request_payload")
  status      String
  resultType  String?  @map("result_type")
  result      Json?
  executionProvenance Json? @map("execution_provenance")
  executionMetadata Json? @map("execution_metadata")
  files       Json?
  errors      Json?
  logsSummary String?  @map("logs_summary")
  createdAt   DateTime @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workflowSteps WorkflowStep[]
  toolCalls     ToolCall[]
  logs          ExecutionLog[]
  agentSession  AgentSession?
  agentInteractions AgentInteraction[]
  agentExecutionEvents AgentExecutionEvent[]

  @@index([appId], map: "idx_executions_app_id")
  @@index([sessionId], map: "idx_executions_session_id")
  @@index([appId, sessionId], map: "idx_executions_app_session")
  @@index([skillId], map: "idx_executions_skill_id")
  @@index([status], map: "idx_executions_status")
  @@index([createdAt], map: "idx_executions_created_at")
  @@map("executions")
}

model AgentSession {
  id                 String   @id
  executionId        String   @unique @map("execution_id")
  appId              String   @map("app_id")
  sessionId          String   @map("session_id")
  backend            String
  transport          String
  state              String
  providerSessionRef String   @map("provider_session_ref")
  providerRunRef     String?  @map("provider_run_ref")
  providerTurnRef    String?  @map("provider_turn_ref")
  continuationMode   String   @map("continuation_mode")
  protocolVersion    String   @map("protocol_version")
  policyBindingHash  String   @default("") @map("policy_binding_hash")
  capabilitySnapshot Json     @map("capability_snapshot")
  lastInteractionSeq Int      @default(0) @map("last_interaction_seq")
  lastEventSeq       Int      @default(0) @map("last_event_seq")
  sessionVersion     Int      @default(1) @map("session_version")
  turnSequence       Int      @default(0) @map("turn_sequence")
  activeChatTurnId   String?  @map("active_chat_turn_id")
  idleExpiresAt      DateTime? @map("idle_expires_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  execution    Execution          @relation(fields: [executionId], references: [id], onDelete: Cascade)
  interactions AgentInteraction[]
  chatTurns    AgentChatTurn[]

  @@index([appId, sessionId], map: "idx_agent_sessions_app_session")
  @@index([state], map: "idx_agent_sessions_state")
  @@map("agent_sessions")
}

model AgentChatTurn {
  id                   String    @id
  agentSessionId       String    @map("agent_session_id")
  executionId          String    @map("execution_id")
  appId                String    @map("app_id")
  sessionId            String    @map("session_id")
  sequence             Int
  idempotencyKey       String    @map("idempotency_key")
  kind                 String
  state                String
  acknowledgementState String    @default("unacknowledged") @map("acknowledgement_state")
  requestSummary       Json      @map("request_summary")
  providerRunRef       String?   @map("provider_run_ref")
  normalizedResult     Json?     @map("normalized_result")
  completedAt          DateTime? @map("completed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  agentSession AgentSession @relation(fields: [agentSessionId], references: [id], onDelete: Cascade)

  @@unique([agentSessionId, sequence], map: "agent_chat_turns_session_sequence_key")
  @@unique([agentSessionId, idempotencyKey], map: "agent_chat_turns_session_idempotency_key")
  @@index([appId, sessionId, executionId], map: "idx_agent_chat_turns_scope")
  @@index([state], map: "idx_agent_chat_turns_state")
  @@map("agent_chat_turns")
}

model AgentInteraction {
  id                     String    @id
  executionId            String    @map("execution_id")
  agentSessionId         String    @map("agent_session_id")
  appId                  String    @map("app_id")
  sessionId              String    @map("session_id")
  sequence               Int
  type                   String
  state                  String
  prompt                 String
  options                Json
  allowsFreeText         Boolean   @map("allows_free_text")
  secretInput            Boolean   @default(false) @map("secret_input")
  providerCorrelationRef String    @map("provider_correlation_ref")
  policyBindingHash      String    @map("policy_binding_hash")
  version                Int       @default(1)
  expiresAt              DateTime  @map("expires_at")
  resolvedAt             DateTime? @map("resolved_at")
  responseSummary        Json?     @map("response_summary")
  idempotencyKey         String?   @map("idempotency_key")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  execution    Execution    @relation(fields: [executionId], references: [id], onDelete: Cascade)
  agentSession AgentSession @relation(fields: [agentSessionId], references: [id], onDelete: Cascade)

  @@unique([executionId, sequence], map: "agent_interactions_execution_sequence_key")
  @@unique([executionId, providerCorrelationRef], map: "agent_interactions_execution_provider_ref_key")
  @@index([appId, sessionId, executionId], map: "idx_agent_interactions_scope")
  @@index([state, expiresAt], map: "idx_agent_interactions_state_expiry")
  @@map("agent_interactions")
}

model AgentExecutionEvent {
  id               String   @id @default(uuid())
  executionId      String   @map("execution_id")
  appId            String   @map("app_id")
  sessionId        String   @map("session_id")
  sequence         Int
  type             String
  providerEventRef String?  @map("provider_event_ref")
  interactionId    String?  @map("interaction_id")
  payload          Json
  occurredAt       DateTime @map("occurred_at")

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, sequence], map: "agent_execution_events_execution_sequence_key")
  @@unique([executionId, providerEventRef], map: "agent_execution_events_execution_provider_ref_key")
  @@index([appId, sessionId, executionId], map: "idx_agent_execution_events_scope")
  @@map("agent_execution_events")
}

model ExecutionConfirmation {
  id             String   @id
  executionId    String   @unique @map("execution_id")
  appId          String   @map("app_id")
  sessionId      String   @map("session_id")
  status         String   @default("pending")
  decision       String   @default("pending")
  policySnapshot Json     @map("policy_snapshot")
  expiresAt      DateTime @map("expires_at")
  decidedAt      DateTime? @map("decided_at")
  consumedAt     DateTime? @map("consumed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([appId, sessionId], map: "idx_execution_confirmations_app_session")
  @@index([status], map: "idx_execution_confirmations_status")
  @@index([expiresAt], map: "idx_execution_confirmations_expires_at")
  @@map("execution_confirmations")
}

model WorkflowStep {
  id            String   @id @default(uuid())
  executionId   String   @map("execution_id")
  stepId        String   @map("step_id")
  stepType      String   @map("step_type")
  status        String
  inputSummary  Json?    @map("input_summary")
  outputSummary Json?    @map("output_summary")
  error         Json?
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime @default(now()) @map("created_at")

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId], map: "idx_workflow_steps_execution_id")
  @@map("workflow_steps")
}

model Skill {
  id                  String   @id
  name                String
  version             String
  description         String?
  inputSchema         Json     @map("input_schema")
  outputSchema        Json     @map("output_schema")
  requiredTools       Json     @map("required_tools")
  requiredPermissions Json     @map("required_permissions")
  workflowDefinition  Json     @map("workflow_definition")
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([name, version], map: "idx_skills_name_version")
  @@map("skills")
}

model Tool {
  id               String   @id
  name             String
  providerType     String   @map("provider_type")
  inputSchema      Json     @map("input_schema")
  outputSchema     Json     @map("output_schema")
  permissionScopes Json     @map("permission_scopes")
  timeoutMs        Int?     @map("timeout_ms")
  sideEffecting    Boolean  @map("side_effecting")
  metadata         Json?
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  toolCalls ToolCall[]

  @@index([providerType], map: "idx_tools_provider_type")
  @@map("tools")
}

model ToolCall {
  id            String   @id @default(uuid())
  executionId   String   @map("execution_id")
  stepId        String   @map("step_id")
  toolId        String   @map("tool_id")
  providerType  String   @map("provider_type")
  status        String
  inputSummary  Json     @map("input_summary")
  outputSummary Json?    @map("output_summary")
  error         Json?
  durationMs    Int?     @map("duration_ms")
  createdAt     DateTime @default(now()) @map("created_at")

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  tool      Tool      @relation(fields: [toolId], references: [id], onDelete: Restrict)

  @@index([executionId], map: "idx_tool_calls_execution_id")
  @@map("tool_calls")
}

model PermissionPolicy {
  id         String   @id @default(uuid())
  appId      String   @map("app_id")
  toolId     String   @map("tool_id")
  scope      String
  policy     String
  conditions Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([appId, toolId, scope], map: "permission_policy_app_tool_scope_key")
  @@map("permission_policies")
}

model McpProvider {
  id               String   @id @default(uuid())
  name             String
  serverUrl        String   @map("server_url")
  authType         String   @map("auth_type")
  authConfig       Json?    @map("auth_config")
  discoveredTools  Json?    @map("discovered_tools")
  lastDiscoveredAt DateTime? @map("last_discovered_at")
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("mcp_providers")
}

model ExecutionLog {
  id          String   @id @default(uuid())
  executionId String   @map("execution_id")
  level       String
  eventType   String   @map("event_type")
  message     String
  summary     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId], map: "idx_execution_logs_execution_id")
  @@map("execution_logs")
}

model AgentSkillProjectionRevision {
  id                String   @id
  builderInstanceId String   @map("builder_instance_id")
  revision          BigInt
  digest            String
  generatedAt       DateTime @map("generated_at")
  receivedAt        DateTime @default(now()) @map("received_at")
  status            String

  items ProjectedAgentSkillGovernance[]
  head  AgentSkillProjectionHead?

  @@unique([builderInstanceId, revision], map: "agent_skill_projection_builder_revision_key")
  @@index([status], map: "idx_agent_skill_projection_revisions_status")
  @@map("agent_skill_projection_revisions")
}

model ProjectedAgentSkillGovernance {
  id                     String  @id @default(uuid())
  projectionRevisionId   String  @map("projection_revision_id")
  appId                  String  @map("app_id")
  agentSkillId           String  @map("agent_skill_id")
  backend                String
  runtimeTargetId        String  @map("runtime_target_id")
  sourceId               String  @map("source_id")
  protectedLocatorRef    String  @map("protected_locator_ref")
  providerSkillName      String  @map("provider_skill_name")
  providerSkillReference String  @map("provider_skill_reference")
  displayName            String  @map("display_name")
  description            String
  currentFingerprint     String  @map("current_fingerprint")
  approvedFingerprint    String  @map("approved_fingerprint")
  sourceEnabled          Boolean @map("source_enabled")
  approvalState          String  @map("approval_state")
  bindingEnabled         Boolean @map("binding_enabled")
  modelVisible           Boolean @map("model_visible")
  userInvocable          Boolean @map("user_invocable")
  directToolDispatch     Boolean @map("direct_tool_dispatch")
  interactionRequirement String  @default("autonomous") @map("interaction_requirement")
  interactionChannel String @default("none") @map("interaction_channel")
  supportedInteractionTypesJson String @default("[]") @map("supported_interaction_types_json")
  requiredTransport      String  @default("one_shot") @map("required_transport")
  recoveryClass          String  @default("not_resumable") @map("recovery_class")

  projectionRevision AgentSkillProjectionRevision @relation(fields: [projectionRevisionId], references: [id], onDelete: Cascade)

  @@unique([projectionRevisionId, appId, agentSkillId], map: "projected_agent_skill_revision_app_skill_key")
  @@index([projectionRevisionId, appId, backend], map: "idx_projected_agent_skill_revision_app_backend")
  @@index([projectionRevisionId, appId, agentSkillId], map: "idx_projected_agent_skill_revision_app_skill")
  @@map("projected_agent_skill_governance")
}

model AgentSkillProjectionHead {
  id               String @id
  activeRevisionId String @unique @map("active_revision_id")

  activeRevision AgentSkillProjectionRevision @relation(fields: [activeRevisionId], references: [id], onDelete: Restrict)

  @@map("agent_skill_projection_head")
}
