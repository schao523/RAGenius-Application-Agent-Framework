{
  "name": "ragenius_execution_subsystem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --experimental-test-isolation=none --test-concurrency=1 --test dist/tests/**/*.test.js",
    "smoke:agent-timeout-cleanup": "npm run build && node --experimental-test-isolation=none --test dist/tests/agents/agent-process-supervisor.test.js",
    "smoke:codex-notebooklm": "tsx scripts/smoke-codex-notebooklm-agent.ts",
    "smoke:codex-agent-skill": "tsx scripts/smoke-codex-agent-skill.ts",
    "smoke:openclaw": "tsx scripts/smoke-openclaw-agent.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@prisma/client": "^6.4.1",
    "fastify": "^5.2.1",
    "yaml": "^2.9.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.4",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "prettier": "^3.5.0",
    "prisma": "^6.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vitest": "^3.0.5"
  }
}
