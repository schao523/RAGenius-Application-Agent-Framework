DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ragenius_execution?schema=public"
NODE_ENV="development"
PORT="3000"
LOG_LEVEL="info"
EXECUTION_CONFIRMATION_TTL_MS="900000"
RAGENIUS_EXECUTION_SERVICE_AUTH_REQUIRED="false"
RAGENIUS_EXECUTION_SERVICE_ID="ragenius_app"
# RAGENIUS_EXECUTION_SERVICE_TOKEN="replace-with-a-long-random-secret"
# Use distinct real secrets for the app and Builder. Never commit them.
# RAGENIUS_EXECUTION_SERVICE_CREDENTIALS_JSON='[{"service_id":"ragenius_app","token":"replace-app-token","scopes":["agent_skills:read"]},{"service_id":"ragenius_builder","token":"replace-builder-token","scopes":["agent_skills:admin"]}]'
AGENT_ASYNC_EXECUTION_ENABLED="true"
AGENT_SKILL_TRUSTED_BUILDER_INSTANCE_ID="builder-primary"
# Administrator-configured discovery roots. These protected locators are never returned to the browser.
# CODEX_AGENT_SKILL_SOURCES_JSON='[{"display_name":"Local Codex Skills","path":"C:\\Users\\User\\.codex\\skills","protected_locator_ref":"codex-local","runtime_target_id":"codex-local"}]'
# OPENCLAW_AGENT_SKILL_ALLOWED_TARGETS_JSON='[{"agent_id":"main","display_name":"OpenClaw Main","protected_locator_ref":"openclaw-main","runtime_target_id":"openclaw-main","skill_roots":["/home/openclaw/.openclaw/skills"],"wsl_distro":"OpenClawGateway"}]'
CODEX_CLI_ENABLED="false"
CODEX_RUN_ROOT="storage/codex-runs"
CODEX_RUN_RETENTION_HOURS="24"
CODEX_MAX_OUTPUT_BYTES="16384"
CODEX_CLI_SANDBOX_MODE="workspace-write"
# Temporary compatibility for accounts redirected to the Gemini Notebook host.
# NOTEBOOKLM_BASE_URL="https://notebook.google.com"
OPENCLAW_RUN_RETENTION_HOURS="24"
