DATABASE_URL="postgresql://ragenius:ragenius@localhost:5433/ragenius_execution?schema=public"
NODE_ENV="development"
PORT="3001"
LOG_LEVEL="info"
EXECUTION_CONFIRMATION_TTL_MS="900000"
RAGENIUS_EXECUTION_SERVICE_AUTH_REQUIRED="false"
RAGENIUS_EXECUTION_SERVICE_ID="ragenius_app"
# RAGENIUS_EXECUTION_SERVICE_TOKEN="replace-with-a-long-random-secret"
# Use distinct real secrets for the app and Builder. Never commit them.
# Interactive execution APIs require the `execution` scope. Builder does not receive it.
# RAGENIUS_EXECUTION_SERVICE_CREDENTIALS_JSON='[{"service_id":"ragenius_app","token":"replace-app-token","scopes":["execution","agent_skills:read","artifacts:write"]},{"service_id":"ragenius_builder","token":"replace-builder-token","scopes":["agent_skills:admin"]}]'
AGENT_INPUT_MAX_BYTES="536870912"
AGENT_INPUT_ALLOWED_MIME_TYPES="video/mp4,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown,application/octet-stream"
AGENT_INPUT_TEMP_RETENTION_HOURS="24"
AGENT_BINARY_IN_MEMORY_MAX_BYTES="26214400"
AGENT_ASYNC_EXECUTION_ENABLED="true"
AGENT_SKILL_TRUSTED_BUILDER_INSTANCE_ID="builder-primary"
# Administrator-configured discovery roots. These protected locators are never returned to the browser.
# Directory sources inspect standalone skills directly. Plugin inventory sources admit only CLI-reported
# local plugin paths contained by the configured broad root. Use the paths reported by
# `codex plugin list --json`; do not approve an entire user profile directory.
# CODEX_AGENT_SKILL_SOURCES_JSON='[{"display_name":"Local Codex Skills","path":"C:\\Users\\User\\.codex\\skills","protected_locator_ref":"codex-local","runtime_target_id":"codex-local-default","discovery_mode":"directory","precedence":100},{"display_name":"Local Agent Skills","path":"C:\\Users\\User\\.agents\\skills","protected_locator_ref":"agents-local","runtime_target_id":"codex-local-default","discovery_mode":"directory","precedence":110},{"display_name":"Bundled Codex Plugins","path":"C:\\Users\\User\\.codex\\.tmp\\bundled-marketplaces\\openai-bundled","protected_locator_ref":"codex-plugin-bundled","runtime_target_id":"codex-local-default","discovery_mode":"plugin_inventory","precedence":10},{"display_name":"Approved Codex Plugin Cache","path":"C:\\Users\\User\\.codex\\.tmp\\plugins","protected_locator_ref":"codex-plugin-cache-primary","runtime_target_id":"codex-local-default","discovery_mode":"plugin_inventory","precedence":20},{"display_name":"Approved Codex Runtime Plugins","path":"C:\\Users\\User\\.cache\\codex-runtimes","protected_locator_ref":"codex-runtime-cache-primary","runtime_target_id":"codex-local-default","discovery_mode":"plugin_inventory","precedence":30}]'
CODEX_AGENT_SKILL_INVENTORY_TIMEOUT_MS="15000"
CODEX_AGENT_SKILL_INVENTORY_MAX_STDOUT_BYTES="1048576"
CODEX_AGENT_SKILL_INVENTORY_MAX_STDERR_BYTES="65536"
CODEX_AGENT_SKILL_MAX_DEPTH="12"
# Trust the stable OpenClaw tools parent rather than a Node-version-specific installation path.
# Discovery still fingerprints each exact skill package and rejects packages outside these roots.
# OPENCLAW_AGENT_SKILL_ALLOWED_TARGETS_JSON='[{"agent_id":"main","display_name":"OpenClaw Main","protected_locator_ref":"openclaw-main","runtime_target_id":"openclaw-main","skill_roots":["/home/openclaw/.openclaw/tools","/home/openclaw/.openclaw/plugin-skills","/home/openclaw/.openclaw/skills"],"wsl_distro":"OpenClawGateway"}]'
CODEX_CLI_ENABLED="false"
CODEX_RUN_ROOT="storage/codex-runs"
CODEX_RUN_RETENTION_HOURS="24"
CODEX_MAX_OUTPUT_BYTES="16384"
CODEX_CLI_SANDBOX_MODE="workspace-write"
CODEX_APP_SERVER_INTERACTIVE_ENABLED="false"
# Enable only after Codex app-server preflight and the Task 9 acceptance matrix pass.
CODEX_APP_SERVER_COMMAND="codex"
CODEX_APP_SERVER_SUPPORTED_VERSIONS="0.146.0"
CODEX_APP_SERVER_INITIALIZATION_TIMEOUT_MS="15000"
CODEX_APP_SERVER_INTERACTION_TTL_MS="900000"
CODEX_APP_SERVER_MAX_LINE_BYTES="2097152"
CODEX_APP_SERVER_MAX_DELTA_BYTES="16384"
CODEX_APP_SERVER_MAX_STDERR_BYTES="65536"
OPENCLAW_GATEWAY_INTERACTIVE_ENABLED="false"
OPENCLAW_GATEWAY_CHAT_LEVEL_ENABLED="false"
OPENCLAW_GATEWAY_CHAT_IDLE_TTL_MS="900000"
# Enabling this flag does not change OpenClaw policy. Policy changes remain administrator actions.
OPENCLAW_GATEWAY_URL="ws://127.0.0.1:18789"
OPENCLAW_GATEWAY_APPROVAL_CREDENTIAL_ENV="OPENCLAW_GATEWAY_APPROVAL_TOKEN"
# Required when OpenClaw interactive mode is enabled. Keep this external operator credential server-side.
# OPENCLAW_GATEWAY_APPROVAL_TOKEN="replace-with-external-operator-token"
OPENCLAW_GATEWAY_SUPPORTED_VERSIONS="2026.6.8"
OPENCLAW_GATEWAY_RPC_TIMEOUT_MS="15000"
OPENCLAW_GATEWAY_INTERACTION_TTL_MS="900000"
OPENCLAW_GATEWAY_MAX_MESSAGE_BYTES="1048576"
OPENCLAW_GATEWAY_RECONNECT_MAX_ATTEMPTS="5"
OPENCLAW_GATEWAY_RECONNECT_BASE_DELAY_MS="250"
# Temporary compatibility for accounts redirected to the Gemini Notebook host.
# NOTEBOOKLM_BASE_URL="https://notebook.google.com"
OPENCLAW_RUN_RETENTION_HOURS="24"
