# RAGenius public Docker demo configuration.
# Copy this file to .env, then set at least one real LLM API key.

# Public GHCR image selection.
RAGENIUS_GHCR_OWNER=schao523
RAGENIUS_IMAGE_TAG=latest
# The public demo images are currently published as linux/amd64 images.
# This keeps Windows ARM Docker Desktop from requesting linux/arm64 manifests.
RAGENIUS_DOCKER_PLATFORM=linux/amd64

# Local host ports.
RAGENIUS_APP_FRONTEND_PORT=5173
RAGENIUS_APP_BACKEND_PORT=8000
RAGENIUS_BUILDER_PORT=8011
RAGENIUS_EXECUTION_PORT=3001
RAGENIUS_POSTGRES_PORT=5433

# PostgreSQL/pgvector container defaults.
POSTGRES_USER=ragenius
POSTGRES_PASSWORD=ragenius
POSTGRES_DB=ragenius

# Retrieval/ingestion embedding runtime.
# The public images do not bundle large local embedding model files.
# Keep this on local for realistic retrieval behavior; ingestion requires mounted model files
# or another explicitly configured embedding backend.
RAG_EMBEDDING_BACKEND=local
RAG_EMBEDDING_MODEL_PATH_BGE_LARGE_ZH=/models/bge-large-zh
RAG_EMBEDDING_MODEL_PATH_E5_LARGE=/models/e5-large

# LLM responses require internet and a real API key.
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# RAGENIUS_LLM_API_KEY=
# RAGENIUS_LLM_BASE_URL=

# Safe public-demo defaults for interactive external tooling.
AGENT_ASYNC_EXECUTION_ENABLED=true
CODEX_CLI_ENABLED=false
CODEX_APP_SERVER_INTERACTIVE_ENABLED=false
CODEX_MCP_ELICITATION_ENABLED=false
CODEX_INTERACTIVE_AUTH_HANDOFF_ENABLED=false
CODEX_INTERACTIVE_USER_ACTION_ENABLED=false
CODEX_MCP_AUTH_ALLOWED_HOSTS_JSON=[]
CODEX_MANAGED_AUTH_TARGETS_JSON=[]
OPENCLAW_GATEWAY_INTERACTIVE_ENABLED=false
OPENCLAW_GATEWAY_CHAT_LEVEL_ENABLED=false

# Demo auth defaults. Keep false for the simple public demo.
RAGENIUS_EXECUTION_SERVICE_AUTH_REQUIRED=false
RAGENIUS_EXECUTION_SERVICE_ID=ragenius_app
# RAGENIUS_EXECUTION_SERVICE_TOKEN=
# RAGENIUS_BUILDER_EXECUTION_SERVICE_TOKEN=
# RAGENIUS_BUILDER_ADMIN_TOKEN=
