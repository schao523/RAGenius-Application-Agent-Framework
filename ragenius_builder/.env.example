RAGENIUS_EXECUTION_BASE_URL=http://127.0.0.1:3001
RAGENIUS_BUILDER_INSTANCE_ID=builder-primary
# Must match a dedicated execution credential with agent_skills:admin scope.
RAGENIUS_BUILDER_EXECUTION_SERVICE_TOKEN=replace-builder-execution-token
# Separate inbound credential for Builder publication administration.
RAGENIUS_BUILDER_ADMIN_TOKEN=replace-builder-admin-token
RAGENIUS_BUILDER_EXECUTION_TIMEOUT_SECONDS=120
RAG_VECTOR_STORE_BACKEND=pgvector
RAG_VECTOR_STORE_DSN=postgresql://ragenius:ragenius@localhost:5433/ragenius
RAG_PGVECTOR_BOOTSTRAP=true

# Optional local state overrides. Relative defaults stay under flask_scaffold.
# RAGENIUS_BUILDER_DB=D:/path/to/rag_app.db
# RAGENIUS_BUILDER_STORAGE_ROOT=D:/path/to/storage
# RAGENIUS_INSTRUCTION_MODEL_SNAPSHOT_ROOT=D:/path/to/instruction_snapshots
